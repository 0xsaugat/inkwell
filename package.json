{
  "name": "inkwell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bootstrap": "node scripts/dev-bootstrap.mjs",
    "dev": "node scripts/dev-bootstrap.mjs && pnpm db:migrate && concurrently -n web,server -c blue,magenta --kill-others-on-fail \"pnpm --filter @inkwell/web dev\" \"pnpm --filter @inkwell/server dev\"",
    "build": "pnpm --filter @inkwell/web build && pnpm --filter @inkwell/server build",
    "start": "concurrently -n web,server -c blue,magenta --kill-others-on-fail \"pnpm --filter @inkwell/web start\" \"pnpm --filter @inkwell/server start\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "e2e": "playwright test",
    "db:generate": "pnpm --filter @inkwell/db db:generate",
    "db:migrate": "pnpm --filter @inkwell/db db:migrate",
    "db:studio": "pnpm --filter @inkwell/db db:studio",
    "seed": "pnpm --filter @inkwell/core seed",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
